{
  "name": "@internalagency/radiance-overlay",
  "version": "0.1.0",
  "description": "A cinematic, audio-reactive desktop runtime for Radiance.",
  "author": "InternalAgencyIO",
  "private": true,
  "productName": "Radiance",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "node scripts/validate-video-assets.mjs && electron-builder --dir --win --x64",
    "dist": "node scripts/validate-video-assets.mjs && electron-builder --win portable --x64",
    "dist:preview": "electron-builder --win portable --x64 --config.win.artifactName=Radiance-preview-${version}-portable.${ext}",
    "install:pet": "node scripts/install-pet.cjs",
    "video:server": "powershell -ExecutionPolicy Bypass -File scripts/video/start-framepack.ps1",
    "video:scene": "powershell -ExecutionPolicy Bypass -File scripts/video/render-scene.ps1",
    "video:all": "powershell -ExecutionPolicy Bypass -File scripts/video/render-all.ps1",
    "video:enrich": "powershell -ExecutionPolicy Bypass -File scripts/video/render-enrichment.ps1",
    "test": "node --test test/scene-engine.test.js",
    "smoke": "electron . --screenshot=artifacts/radiance-overlay.png"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "build": {
    "appId": "ai.internalagency.radiance",
    "productName": "Radiance",
    "asar": true,
    "asarUnpack": [
      "assets/videos/**/*"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "Radiance-${version}-portable.${ext}"
    }
  }
}
