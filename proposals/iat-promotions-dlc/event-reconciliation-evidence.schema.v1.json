{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internalagency.io/schemas/draft/iat-promotions-dlc-event-reconciliation-evidence-v1.json",
  "title": "IAT Promotions DLC event reconciliation evidence v1",
  "description": "DRAFT / INACTIVE / NOT PART OF GENESIS / NOT DEPLOYED / NO CLAIM ROUTE. Network-free semantic evidence only.",
  "x-iat-status": {
    "labels": ["DRAFT", "INACTIVE", "NOT PART OF GENESIS", "NOT DEPLOYED", "NO CLAIM ROUTE"],
    "network": "NONE",
    "programId": null,
    "deployable": false,
    "schemaApplied": false
  },
  "type": "object",
  "required": ["records", "snapshot"],
  "additionalProperties": false,
  "properties": {
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/eventRecord" }
    },
    "snapshot": { "$ref": "#/definitions/snapshot" }
  },
  "definitions": {
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bytesHex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$" },
    "campaignStatus": {
      "type": "string",
      "enum": ["INITIALIZED", "FUNDED", "ACTIVE", "EXHAUSTED", "CANCELLED"]
    },
    "registryStatus": {
      "type": "string",
      "enum": ["ACTIVE", "EMERGENCY_DISABLED"]
    },
    "eventRecord": {
      "type": "object",
      "required": ["ordinal", "transaction_message_hash", "log_index", "bytes_hex"],
      "additionalProperties": false,
      "properties": {
        "ordinal": { "$ref": "#/definitions/decimal" },
        "transaction_message_hash": { "$ref": "#/definitions/hex32" },
        "log_index": { "$ref": "#/definitions/decimal" },
        "bytes_hex": { "$ref": "#/definitions/bytesHex" }
      }
    },
    "campaign": {
      "type": "object",
      "required": [
        "address",
        "mint",
        "status",
        "promo_vault",
        "community_refund_token_account",
        "verifier_registry",
        "genesis_timestamp",
        "earliest_activation_timestamp",
        "maximum_budget_base_units",
        "maximum_completed_pairs",
        "completed_pairs",
        "hero_paid_base_units",
        "proposer_paid_base_units",
        "policy_hash",
        "identity_domain_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/definitions/hex32" },
        "mint": { "$ref": "#/definitions/hex32" },
        "status": { "$ref": "#/definitions/campaignStatus" },
        "promo_vault": { "$ref": "#/definitions/hex32" },
        "community_refund_token_account": { "$ref": "#/definitions/hex32" },
        "verifier_registry": { "$ref": "#/definitions/hex32" },
        "genesis_timestamp": { "$ref": "#/definitions/decimal" },
        "earliest_activation_timestamp": { "$ref": "#/definitions/decimal" },
        "maximum_budget_base_units": { "const": "180000000000000" },
        "maximum_completed_pairs": { "const": "1000" },
        "completed_pairs": { "$ref": "#/definitions/decimal" },
        "hero_paid_base_units": { "$ref": "#/definitions/decimal" },
        "proposer_paid_base_units": { "$ref": "#/definitions/decimal" },
        "policy_hash": { "$ref": "#/definitions/hex32" },
        "identity_domain_hash": { "$ref": "#/definitions/hex32" }
      }
    },
    "promotionVault": {
      "type": "object",
      "required": ["address", "balance_base_units"],
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/definitions/hex32" },
        "balance_base_units": { "$ref": "#/definitions/decimal" }
      }
    },
    "settlementReceipt": {
      "type": "object",
      "required": [
        "address",
        "campaign",
        "nomination",
        "hero_wallet",
        "proposer_wallet",
        "hero_node_commitment",
        "proposer_node_commitment",
        "hero_x_identity_commitment",
        "proposer_x_identity_commitment",
        "settled_at",
        "sequence",
        "hero_reward_base_units",
        "proposer_reward_base_units"
      ],
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/definitions/hex32" },
        "campaign": { "$ref": "#/definitions/hex32" },
        "nomination": { "$ref": "#/definitions/hex32" },
        "hero_wallet": { "$ref": "#/definitions/hex32" },
        "proposer_wallet": { "$ref": "#/definitions/hex32" },
        "hero_node_commitment": { "$ref": "#/definitions/hex32" },
        "proposer_node_commitment": { "$ref": "#/definitions/hex32" },
        "hero_x_identity_commitment": { "$ref": "#/definitions/hex32" },
        "proposer_x_identity_commitment": { "$ref": "#/definitions/hex32" },
        "settled_at": { "$ref": "#/definitions/decimal" },
        "sequence": { "$ref": "#/definitions/decimal" },
        "hero_reward_base_units": { "const": "120000000000" },
        "proposer_reward_base_units": { "const": "60000000000" }
      }
    },
    "verifierRegistry": {
      "type": "object",
      "required": ["address", "campaign", "status", "last_event_hash"],
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/definitions/hex32" },
        "campaign": { "$ref": "#/definitions/hex32" },
        "status": { "$ref": "#/definitions/registryStatus" },
        "last_event_hash": { "$ref": "#/definitions/hex32" }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["campaign", "promotionVault", "settlementReceipts", "verifierRegistries"],
      "additionalProperties": false,
      "properties": {
        "campaign": { "$ref": "#/definitions/campaign" },
        "promotionVault": { "$ref": "#/definitions/promotionVault" },
        "settlementReceipts": {
          "type": "array",
          "items": { "$ref": "#/definitions/settlementReceipt" }
        },
        "verifierRegistries": {
          "type": "array",
          "items": { "$ref": "#/definitions/verifierRegistry" }
        }
      }
    }
  }
}
