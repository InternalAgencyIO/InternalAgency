{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internalagency.io/schemas/draft/iat-promotions-dlc-reviewer-candidate-v1.json",
  "title": "IAT Promotions DLC independent-review candidate v1",
  "description": "DRAFT / INACTIVE / NOT PART OF GENESIS / NOT DEPLOYED / NO CLAIM ROUTE. Structural validity is not review acceptance, receipt issuance, or activation authority.",
  "x-iat-status": {
    "labels": ["DRAFT", "INACTIVE", "NOT PART OF GENESIS", "NOT DEPLOYED", "NO CLAIM ROUTE"],
    "network": "NONE",
    "programId": null,
    "deployable": false,
    "schemaApplied": false
  },
  "type": "object",
  "required": ["target", "scope", "reviewer", "payload", "attestation"],
  "additionalProperties": false,
  "properties": {
    "target": { "$ref": "#/definitions/target" },
    "scope": { "$ref": "#/definitions/scope" },
    "reviewer": { "$ref": "#/definitions/reviewer" },
    "payload": { "$ref": "#/definitions/payload" },
    "attestation": { "$ref": "#/definitions/attestation" }
  },
  "definitions": {
    "hex40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hex128": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "target": {
      "type": "object",
      "required": ["gitCommitSha", "reviewManifestContentSha256", "reviewTreeRootSha256", "coveredFileCount"],
      "additionalProperties": false,
      "properties": {
        "gitCommitSha": { "$ref": "#/definitions/hex40" },
        "reviewManifestContentSha256": { "$ref": "#/definitions/hex64" },
        "reviewTreeRootSha256": { "$ref": "#/definitions/hex64" },
        "coveredFileCount": { "$ref": "#/definitions/decimal" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["reviewAreas", "explicitExclusions", "manifestEntryCount", "openSecurityDecisionDispositions"],
      "additionalProperties": false,
      "properties": {
        "reviewAreas": {
          "const": [
            "PROTOCOL_AND_ECONOMICS",
            "IDENTITY_AND_DEDUPLICATION",
            "ATOMIC_SETTLEMENT_AND_ROLLBACK",
            "VAULT_AND_AUTHORITY_ISOLATION",
            "VERIFIER_KEY_LIFECYCLE",
            "EVENT_ACCOUNT_RECONCILIATION",
            "CLIENT_ABI_AND_FIXED_BYTES",
            "ADVERSARIAL_TESTS_AND_REPRODUCIBILITY"
          ]
        },
        "explicitExclusions": {
          "const": [
            "PRODUCTION_V2_CODE",
            "LIVE_SITES",
            "MAINNET_STATE",
            "DEVNET_STATE",
            "WALLETS_AND_KEYS",
            "DNS_AND_HOSTING",
            "GENESIS_RELEASE_GATES"
          ]
        },
        "manifestEntryCount": { "$ref": "#/definitions/decimal" },
        "openSecurityDecisionDispositions": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/disposition" }
        }
      }
    },
    "disposition": {
      "type": "object",
      "required": ["id", "disposition", "evidenceCommitmentSha256"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "UPGRADE_AUTHORITY_POLICY",
            "IDENTITY_VERIFIER_KEY_CUSTODY",
            "INDEPENDENT_REVIEWER_THRESHOLD",
            "IDENTITY_COMMITMENT_PEPPER_CUSTODY",
            "X_API_TERMS_AVAILABILITY_RETENTION",
            "RELAYER_AND_RENT_FUNDING",
            "COMMUNITY_REFUND_ACCOUNT",
            "PUBLIC_HANDLE_DISPLAY_CONSENT",
            "LEGAL_AND_REGIONAL_RESTRICTIONS"
          ]
        },
        "disposition": { "type": "string", "enum": ["RESOLVED", "ACCEPTED_RISK", "DEFERRED_BLOCKING"] },
        "evidenceCommitmentSha256": { "$ref": "#/definitions/hex64" }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["accountabilityLabel", "reviewerIdentityCommitmentSha256", "independenceDeclaration", "concurrentRoles"],
      "additionalProperties": false,
      "properties": {
        "accountabilityLabel": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewerIdentityCommitmentSha256": { "$ref": "#/definitions/hex64" },
        "independenceDeclaration": { "const": true },
        "concurrentRoles": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
        }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "gitCommitSha",
        "reviewManifestContentSha256",
        "reviewTreeRootSha256",
        "coveredFileCount",
        "scopeCanonicalSha256",
        "accountabilityLabel",
        "reviewerIdentityCommitmentSha256",
        "independenceDeclaration",
        "decision",
        "rationaleCanonicalSha256",
        "findingsCommitmentSha256",
        "reviewedAtUnixSeconds",
        "activationAuthorized",
        "activationEffect"
      ],
      "additionalProperties": false,
      "properties": {
        "gitCommitSha": { "$ref": "#/definitions/hex40" },
        "reviewManifestContentSha256": { "$ref": "#/definitions/hex64" },
        "reviewTreeRootSha256": { "$ref": "#/definitions/hex64" },
        "coveredFileCount": { "$ref": "#/definitions/decimal" },
        "scopeCanonicalSha256": { "$ref": "#/definitions/hex64" },
        "accountabilityLabel": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewerIdentityCommitmentSha256": { "$ref": "#/definitions/hex64" },
        "independenceDeclaration": { "const": true },
        "decision": { "type": "string", "enum": ["APPROVE_REVIEW_ONLY", "REQUEST_CHANGES", "REJECT"] },
        "rationaleCanonicalSha256": { "$ref": "#/definitions/hex64" },
        "findingsCommitmentSha256": { "$ref": "#/definitions/hex64" },
        "reviewedAtUnixSeconds": { "$ref": "#/definitions/decimal" },
        "activationAuthorized": { "const": false },
        "activationEffect": { "const": "NONE" }
      }
    },
    "attestation": {
      "type": "object",
      "required": ["algorithm", "publicKeyHex", "signatureHex", "payloadSha256"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "publicKeyHex": { "$ref": "#/definitions/hex64" },
        "signatureHex": { "$ref": "#/definitions/hex128" },
        "payloadSha256": { "$ref": "#/definitions/hex64" }
      }
    }
  }
}
