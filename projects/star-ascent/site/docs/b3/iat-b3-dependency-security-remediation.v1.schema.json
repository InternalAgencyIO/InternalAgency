{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.agency/schemas/iat-b3-dependency-security-remediation.v1.schema.json",
  "title": "IAT B3 dependency security remediation packet v2 (compatibility filename retained)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "status",
    "scope",
    "remediationCommit",
    "sourceBindings",
    "observedAtUtc",
    "auditToolchain",
    "beforeRemediation",
    "auditObservations",
    "remediations",
    "informationalFindings",
    "automatedDirectEvidence",
    "technicalRemediationComplete",
    "zeroKnownVulnerabilitiesObserved",
    "zeroUnacceptedDependencyFindings",
    "completionPredicateSatisfied",
    "activationReady",
    "releaseAuthorizationVerified",
    "mainnetExecutionAuthorized",
    "mainnetStatus"
  ],
  "properties": {
    "$schema": { "const": "./iat-b3-dependency-security-remediation.v1.schema.json" },
    "schema": { "const": "iat-b3-dependency-security-remediation/v2" },
    "status": { "const": "TECHNICAL_REMEDIATION_COMPLETE_AUTOMATED_DIRECT_EVIDENCE_PENDING" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "certifies", "doesNotCertify"],
      "properties": {
        "predicate": { "const": "ZERO_UNACCEPTED_DEPENDENCY_FINDINGS_PACKET" },
        "certifies": {
          "const": [
            "EXACT_REMEDIATION_COMMIT_AND_LOCKFILE_BINDING",
            "ZERO_NPM_AUDIT_VULNERABILITIES_AT_OBSERVATION",
            "ZERO_CARGO_AUDIT_VULNERABILITIES_AT_OBSERVATION",
            "EXPLICIT_INFORMATIONAL_FINDING_INVENTORY"
          ]
        },
        "doesNotCertify": {
          "const": [
            "FUTURE_REGISTRY_OR_ADVISORY_DATABASE_STATE",
            "TRANSITIVE_UNMAINTAINED_DEPENDENCY_RISK_ACCEPTANCE",
            "SOURCE_BOUND_AUTOMATED_SECURITY_EVIDENCE_CLOSURE",
            "PRODUCTION_BINARY_DEVNET_RELEASE_OR_MAINNET_AUTHORIZATION"
          ]
        }
      }
    },
    "remediationCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "parentSha", "subject"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "parentSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "subject": { "type": "string", "minLength": 1 }
      }
    },
    "sourceBindings": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": { "$ref": "#/$defs/sourceBinding" }
    },
    "observedAtUtc": { "type": "string", "format": "date-time" },
    "auditToolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npmVersion", "cargoAuditVersion", "rustSecDatabaseCommit", "rustSecDatabaseUpdatedAt", "rustSecAdvisoryCount"],
      "properties": {
        "npmVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "cargoAuditVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "rustSecDatabaseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "rustSecDatabaseUpdatedAt": { "type": "string", "format": "date-time" },
        "rustSecAdvisoryCount": { "type": "integer", "minimum": 1 }
      }
    },
    "beforeRemediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteNpmHigh", "siteNpmModerate", "siteNpmTotal"],
      "properties": {
        "siteNpmHigh": { "type": "integer", "minimum": 0 },
        "siteNpmModerate": { "type": "integer", "minimum": 0 },
        "siteNpmTotal": { "type": "integer", "minimum": 0 }
      }
    },
    "auditObservations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "dependencyCount", "vulnerabilityCount", "informationalWarningCount"],
        "properties": {
          "kind": { "enum": ["NPM_LOCKFILE", "CARGO_LOCKFILE"] },
          "path": { "type": "string", "minLength": 1 },
          "dependencyCount": { "type": "integer", "minimum": 0 },
          "vulnerabilityCount": { "type": "integer", "minimum": 0 },
          "informationalWarningCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "remediations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "informationalFindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "package", "version", "classification", "transitiveThrough", "patchedVersions", "unaffectedVersions", "accepted", "disposition"],
        "properties": {
          "id": { "const": "RUSTSEC-2025-0141" },
          "package": { "const": "bincode" },
          "version": { "const": "1.3.3" },
          "classification": { "const": "UNMAINTAINED_NOT_KNOWN_VULNERABLE" },
          "transitiveThrough": { "const": ["ANCHOR", "SOLANA"] },
          "patchedVersions": { "const": [] },
          "unaffectedVersions": { "const": [] },
          "accepted": { "const": false },
          "disposition": { "const": "PENDING_EXPLICIT_OWNER_RISK_DECISION" }
        }
      }
    },
    "automatedDirectEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "receiptSha256", "stateDigestSha256", "endpointEvidenceSha256", "observedAtUtc", "freshnessWindowSeconds", "directEvidenceOnly", "packetMaySelectEvidenceSources", "noSelfAttestation", "humanReviewerRequired"],
      "properties": {
        "schema": { "const": "iat-b3-dependency-security-automated-direct-evidence/v1" },
        "status": { "const": "SOURCE_BOUND_RECEIPT_STATE_ENDPOINT_EVIDENCE_UNOBSERVED" },
        "receiptSha256": { "type": "null" },
        "stateDigestSha256": { "type": "null" },
        "endpointEvidenceSha256": { "type": "null" },
        "observedAtUtc": { "type": "null" },
        "freshnessWindowSeconds": { "const": 900 },
        "directEvidenceOnly": { "const": true },
        "packetMaySelectEvidenceSources": { "const": false },
        "noSelfAttestation": { "const": true },
        "humanReviewerRequired": { "const": false }
      }
    },
    "technicalRemediationComplete": { "const": true },
    "zeroKnownVulnerabilitiesObserved": { "const": true },
    "zeroUnacceptedDependencyFindings": { "const": false },
    "completionPredicateSatisfied": { "const": false },
    "activationReady": { "const": false },
    "releaseAuthorizationVerified": { "const": false },
    "mainnetExecutionAuthorized": { "const": false },
    "mainnetStatus": { "const": "HOLD" }
  },
  "$defs": {
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteLength"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byteLength": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
