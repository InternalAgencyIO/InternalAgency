{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internalagency.io/schemas/iat-v2-independent-security-evidence.v2.schema.json",
  "title": "IAT V2 independently completed IAT-surface current-source CI security evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "predicate",
    "sourceBinding",
    "ciProvenance",
    "inputBindings",
    "toolchain",
    "checks",
    "findingSummary",
    "artifactContract",
    "observedAtUtc",
    "expiresAtUtc",
    "safety",
    "limitations",
    "mainnetStatus"
  ],
  "properties": {
    "schema": { "const": "iat-v2-independent-security-evidence/v2" },
    "status": { "const": "SECURITY_SUITE_COMPLETE_HOLD" },
    "predicate": { "const": "AUTOMATED_SECURITY_CLOSURE" },
    "sourceBinding": { "$ref": "#/$defs/sourceBinding" },
    "ciProvenance": { "$ref": "#/$defs/ciProvenance" },
    "inputBindings": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/inputBinding" }
    },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/check" }
    },
    "findingSummary": { "$ref": "#/$defs/findingSummary" },
    "artifactContract": { "$ref": "#/$defs/artifactContract" },
    "observedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "safety": { "$ref": "#/$defs/safety" },
    "limitations": {
      "const": [
        "Exact current-source IAT-site dependency audits and fixed IAT security regressions only; the unrelated repository-root Radiance package is outside this evidence contract, and this is not a comprehensive economic, privacy, legal, or human review.",
        "Evidence remains bounded to its public GitHub run, advisory snapshot, source commit, source tree, and reviewed program artifact.",
        "Does not prove a signed Devnet rehearsal and does not authorize funding, signing, broadcast, deployment, release, scheduling, or Mainnet execution."
      ]
    },
    "mainnetStatus": { "const": "HOLD" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "programArtifactSha256"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitObject" },
        "tree": { "$ref": "#/$defs/gitObject" },
        "programArtifactSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ciProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverUrl",
        "repository",
        "repositoryId",
        "workflowRef",
        "workflowPath",
        "workflowSha256",
        "runId",
        "runAttempt",
        "eventName",
        "sourceHeadSha",
        "checkoutSha",
        "checkoutRelation",
        "jobKey",
        "jobName",
        "runnerOs",
        "runnerArch",
        "artifactName"
      ],
      "properties": {
        "serverUrl": { "const": "https://github.com" },
        "repository": { "const": "InternalAgencyIO/InternalAgency" },
        "repositoryId": { "const": 1313660798 },
        "workflowRef": {
          "type": "string",
          "pattern": "^InternalAgencyIO/InternalAgency/\\.github/workflows/iat-v2-independent-security-evidence\\.yml@refs/(heads/.+|pull/[1-9][0-9]*/merge)$"
        },
        "workflowPath": { "const": ".github/workflows/iat-v2-independent-security-evidence.yml" },
        "workflowSha256": { "$ref": "#/$defs/sha256" },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "eventName": { "enum": ["pull_request", "push", "workflow_dispatch"] },
        "sourceHeadSha": { "$ref": "#/$defs/gitObject" },
        "checkoutSha": { "$ref": "#/$defs/gitObject" },
        "checkoutRelation": { "const": "IDENTICAL" },
        "jobKey": { "const": "security-evidence" },
        "jobName": { "const": "Independent IAT-surface current-source security evidence (Mainnet HOLD)" },
        "runnerOs": { "const": "Linux" },
        "runnerArch": { "const": "X64" },
        "artifactName": { "const": "iat-v2-independent-security-evidence-v2" }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$"
        },
        "kind": { "enum": ["LOCKFILE", "WORKFLOW", "SECURITY_REGRESSION"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeVersion",
        "npmVersion",
        "cargoAuditVersion",
        "rustSecDatabaseCommit",
        "rustSecDatabaseUpdatedAtUtc",
        "rustSecAdvisoryCount"
      ],
      "properties": {
        "nodeVersion": { "type": "string", "pattern": "^v24\\.[0-9]+\\.[0-9]+$" },
        "npmVersion": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$" },
        "cargoAuditVersion": { "const": "cargo-audit 0.22.2" },
        "rustSecDatabaseCommit": { "$ref": "#/$defs/gitObject" },
        "rustSecDatabaseUpdatedAtUtc": { "type": "string", "format": "date-time" },
        "rustSecAdvisoryCount": { "type": "integer", "minimum": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "inputPath", "rawPath", "rawSha256", "rawBytes", "exitCodePath", "exitCodeSha256", "exitCodeBytes", "exitCode", "observation"],
      "properties": {
        "id": {
          "enum": [
            "NPM_SITE_AUDIT",
            "CARGO_SITE_AUDIT",
            "CARGO_ACCOUNT_LIFECYCLE_AUDIT",
            "CARGO_STAKE_INGRESS_AUDIT",
            "SECURITY_REGRESSION_SUITE"
          ]
        },
        "kind": { "enum": ["NPM_AUDIT", "CARGO_AUDIT", "NODE_TEST_TAP"] },
        "inputPath": { "type": ["string", "null"] },
        "rawPath": { "type": "string", "pattern": "^raw/[a-z0-9.-]+$" },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "rawBytes": { "type": "integer", "minimum": 1 },
        "exitCodePath": { "type": "string", "pattern": "^raw/[a-z0-9.-]+\\.exit-code\\.txt$" },
        "exitCodeSha256": { "$ref": "#/$defs/sha256" },
        "exitCodeBytes": { "const": 2 },
        "exitCode": { "const": 0 },
        "observation": {
          "oneOf": [
            { "$ref": "#/$defs/npmObservation" },
            { "$ref": "#/$defs/cargoObservation" },
            { "$ref": "#/$defs/tapObservation" }
          ]
        }
      }
    },
    "npmObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditReportVersion", "critical", "high", "moderate", "low", "info", "total"],
      "properties": {
        "auditReportVersion": { "const": 2 },
        "critical": { "const": 0 },
        "high": { "const": 0 },
        "moderate": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "cargoObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyCount", "vulnerabilityCount", "informationalFindingIds"],
      "properties": {
        "dependencyCount": { "type": "integer", "minimum": 0 },
        "vulnerabilityCount": { "const": 0 },
        "informationalFindingIds": {
          "type": "array",
          "contains": { "const": "RUSTSEC-2025-0141" },
          "uniqueItems": true
        }
      }
    },
    "tapObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testCount", "passCount", "failCount"],
      "properties": {
        "testCount": { "type": "integer", "minimum": 1 },
        "passCount": { "type": "integer", "minimum": 1 },
        "failCount": { "const": 0 }
      }
    },
    "findingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical",
        "high",
        "moderate",
        "low",
        "informational",
        "total",
        "unresolvedCritical",
        "unresolvedHigh",
        "zeroUnacceptedCriticalOrHigh",
        "unresolvedInformational"
      ],
      "properties": {
        "critical": { "const": 0 },
        "high": { "const": 0 },
        "moderate": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "informational": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 1 },
        "unresolvedCritical": { "const": 0 },
        "unresolvedHigh": { "const": 0 },
        "zeroUnacceptedCriticalOrHigh": { "const": true },
        "unresolvedInformational": {
          "const": [
            {
              "id": "RUSTSEC-2025-0141",
              "package": "bincode",
              "version": "1.3.3",
              "classification": "UNMAINTAINED_NOT_KNOWN_VULNERABLE",
              "accepted": false,
              "disposition": "UNRESOLVED_INFORMATIONAL"
            }
          ]
        }
      }
    },
    "artifactContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "manifestPath", "entries"],
      "properties": {
        "name": { "const": "iat-v2-independent-security-evidence-v2" },
        "manifestPath": { "const": "iat-v2-independent-security-evidence-v2.json" },
        "entries": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialMaterialIncluded",
        "walletAccessed",
        "deviceAccessed",
        "signingPerformed",
        "simulationForSigningPerformed",
        "broadcastingPerformed",
        "deploymentPerformed",
        "productionResourceMutationPerformed",
        "mainnetRequestPerformed",
        "scannerNetworkRequestsPermitted",
        "authorizesMainnet"
      ],
      "properties": {
        "credentialMaterialIncluded": { "const": false },
        "walletAccessed": { "const": false },
        "deviceAccessed": { "const": false },
        "signingPerformed": { "const": false },
        "simulationForSigningPerformed": { "const": false },
        "broadcastingPerformed": { "const": false },
        "deploymentPerformed": { "const": false },
        "productionResourceMutationPerformed": { "const": false },
        "mainnetRequestPerformed": { "const": false },
        "scannerNetworkRequestsPermitted": { "const": true },
        "authorizesMainnet": { "const": false }
      }
    }
  }
}
