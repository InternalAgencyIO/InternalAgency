{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iat:b3:production-identity-authority-evidence:v3",
  "title": "IAT B3 staged production identity, funding, and deployed-authority evidence",
  "description": "Strict nonactivating automated receipt/state/endpoint evidence intake. Owner decisions require an exact Solana OCMS v0/v1 envelope plus a separate source-bound Model T firmware/capability observation; Ed25519 bytes alone never prove hardware provenance. This schema never authorizes signing, deployment, spending, activation, release, or Mainnet execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "profile",
    "status",
    "scope",
    "sourceBindings",
    "modelTCapabilityBoundary",
    "productionChoices",
    "phaseAProductionIdentityFreeze",
    "phaseBCeremonyFunding",
    "phaseCDeployedSeal",
    "authorizationBoundary"
  ],
  "properties": {
    "$schema": {
      "const": "./iat-b3-production-identity-authority-evidence.v1.schema.json"
    },
    "schema": {
      "const": "iat-b3-production-identity-authority-evidence/v3"
    },
    "profile": {
      "enum": ["PRODUCTION", "TEST_FIXTURE"]
    },
    "status": {
      "enum": ["PENDING", "EVIDENCE_COMPLETE"]
    },
    "scope": {
      "const": {
        "contract": "NONACTIVATING_PRODUCTION_IDENTITY_AUTHORITY_EVIDENCE_INTAKE",
        "stagedPredicates": [
          "A_PRODUCTION_IDENTITY_INPUT_FREEZE",
          "B_COST_CEREMONY_FUNDING",
          "C_DEPLOYED_IDENTITY_AUTHORITY_SEAL"
        ],
        "doesNotCertify": [
          "PACKET_SELECTED_AUTOMATED_EVIDENCE_SOURCES",
          "LIVE_RPC_OR_CHAIN_TRUTH_WITHOUT_TWO_SOURCE_BOUND_ENDPOINT_RECEIPTS",
          "FINAL_BINARY_TRUTH_WITHOUT_EXACT_BINDINGS",
          "OWNER_DECISION_OR_AUTOMATED_CLOSURE_TRUTH_WITHOUT_EXTERNAL_SOURCE_CONFIGURATION",
          "MODEL_T_SOLANA_OCMS_CAPABILITY_WITHOUT_SEPARATE_SOURCE_BOUND_DEVICE_OBSERVATION",
          "MODEL_T_HARDWARE_PROVENANCE_FROM_ED25519_SIGNATURE_BYTES_ALONE",
          "TRANSACTION_SIGNING_DEPLOYMENT_FUNDING_OR_ACTIVATION_AUTHORITY",
          "AUTOMATED_GATE_8_EVIDENCE_COMPLETION",
          "RELEASE_OR_MAINNET_EXECUTION_AUTHORIZATION"
        ]
      }
    },
    "sourceBindings": {
      "const": {
        "ownerPolicyFreeze": {
          "path": "projects/star-ascent/site/docs/b3/iat-b3-owner-policy-freeze.v1.json",
          "sha256": "95c508a47f9ccfed8d466851196cf4de0928027bebccc35b5842fb2c77449f06",
          "bindingScope": "EXACT_COMMITTED_INPUT_ONLY"
        },
        "identityInputFreeze": {
          "path": "projects/star-ascent/site/docs/b3/iat-b3-identity-freeze.v1.json",
          "sha256": "17bcf00f97c5fd95bc39fa9eff120fd7f7678ed77f9bc333c36189f44633cacf",
          "bindingScope": "EXACT_COMMITTED_INPUT_ONLY"
        },
        "costFeasibilityReference": {
          "path": "projects/star-ascent/site/docs/b3/COST_FEASIBILITY.md",
          "sha256": "44684ef17a173e01eb36e9e7a0de3297b62c5f7b6aa1035f0d1995641ba3c289",
          "bindingScope": "REFERENCE_ONLY_NEVER_COMPLETION_EVIDENCE"
        }
      }
    },
    "modelTCapabilityBoundary": {
      "const": {
        "predicate": "MODEL_T_SOLANA_OCMS_CAPABILITY_OBSERVED",
        "requiredDeviceModel": "Trezor Model T",
        "acceptedOcmsVersions": ["OCMS_V0", "OCMS_V1"],
        "ocmsV0FirmwareRange": ">=2.12.1 <2.12.4",
        "ocmsV1FirmwareRange": ">=2.12.4",
        "sourceRequirement": "SEPARATE_EXTERNAL_SOURCE_BOUND_DEVICE_OBSERVATION_RECEIPT",
        "signerPathAndPublicKeyMustMatchObservation": true,
        "signatureBytesProveHardwareProvenance": false,
        "rawEd25519OwnerDecisionAllowed": false,
        "packetSelfAttestedCapabilityObserved": false
      }
    },
    "productionChoices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lawProgramId",
        "economyProgramId",
        "canonicalMint",
        "mainnetGenesisHash",
        "ceremonySignerPublicKey",
        "lawUpgradeAuthorityPublicKey",
        "economyUpgradeAuthorityPublicKey",
        "payerPublicKey"
      ],
      "properties": {
        "lawProgramId": { "$ref": "#/$defs/nullableBase58" },
        "economyProgramId": { "$ref": "#/$defs/nullableBase58" },
        "canonicalMint": { "$ref": "#/$defs/nullableBase58" },
        "mainnetGenesisHash": { "$ref": "#/$defs/nullableBase58" },
        "ceremonySignerPublicKey": { "$ref": "#/$defs/nullableBase58" },
        "lawUpgradeAuthorityPublicKey": { "$ref": "#/$defs/nullableBase58" },
        "economyUpgradeAuthorityPublicKey": { "$ref": "#/$defs/nullableBase58" },
        "payerPublicKey": { "$ref": "#/$defs/nullableBase58" }
      }
    },
    "phaseAProductionIdentityFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "subjectSha256",
        "ownerDecisionPreimageSha256",
        "ownerDecisionReceipt",
        "mainnetGenesisEndpointReceipts",
        "automatedClosureReceipt",
        "blocker"
      ],
      "properties": {
        "status": { "enum": ["PENDING", "EVIDENCE_COMPLETE"] },
        "subjectSha256": { "$ref": "#/$defs/nullableSha256" },
        "ownerDecisionPreimageSha256": { "$ref": "#/$defs/nullableSha256" },
        "ownerDecisionReceipt": { "$ref": "#/$defs/nullableOwnerDecisionReceipt" },
        "mainnetGenesisEndpointReceipts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/receipt" }
        },
        "automatedClosureReceipt": { "$ref": "#/$defs/nullableReceipt" },
        "blocker": { "$ref": "#/$defs/nullableBlocker" }
      }
    },
    "phaseBCeremonyFunding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "subjectSha256",
        "finalBinaries",
        "freshCostMeasurementSha256",
        "fundingSourceApprovalSha256",
        "ceremonyFloorPolicySha256",
        "bufferRecoveryPlanSha256",
        "ceremonyFloorLamports",
        "aggregateFreshPayerPeakLamports",
        "aggregatePermanentRentLamports",
        "aggregateRecoverableBufferLamports",
        "aggregateFeeBudgetLamports",
        "expiresAtUnixSeconds",
        "fundingDecisionReceipt",
        "payerBalanceEndpointReceipts",
        "automatedClosureReceipt",
        "blocker"
      ],
      "properties": {
        "status": { "enum": ["PENDING", "EVIDENCE_COMPLETE"] },
        "subjectSha256": { "$ref": "#/$defs/nullableSha256" },
        "finalBinaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["law", "economy"],
          "properties": {
            "law": { "$ref": "#/$defs/binaryBinding" },
            "economy": { "$ref": "#/$defs/binaryBinding" }
          }
        },
        "freshCostMeasurementSha256": { "$ref": "#/$defs/nullableSha256" },
        "fundingSourceApprovalSha256": { "$ref": "#/$defs/nullableSha256" },
        "ceremonyFloorPolicySha256": { "$ref": "#/$defs/nullableSha256" },
        "bufferRecoveryPlanSha256": { "$ref": "#/$defs/nullableSha256" },
        "ceremonyFloorLamports": { "$ref": "#/$defs/nullableU64" },
        "aggregateFreshPayerPeakLamports": { "$ref": "#/$defs/nullableU64" },
        "aggregatePermanentRentLamports": { "$ref": "#/$defs/nullableU64" },
        "aggregateRecoverableBufferLamports": { "$ref": "#/$defs/nullableU64" },
        "aggregateFeeBudgetLamports": { "$ref": "#/$defs/nullableU64" },
        "expiresAtUnixSeconds": { "$ref": "#/$defs/nullableU64" },
        "fundingDecisionReceipt": { "$ref": "#/$defs/nullableOwnerDecisionReceipt" },
        "payerBalanceEndpointReceipts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/receipt" }
        },
        "automatedClosureReceipt": { "$ref": "#/$defs/nullableReceipt" },
        "blocker": { "$ref": "#/$defs/nullableBlocker" }
      }
    },
    "phaseCDeployedSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "subjectSha256",
        "journal",
        "terminalState",
        "terminalEndpointReceipts",
        "automatedClosureReceipt",
        "blocker"
      ],
      "properties": {
        "status": { "enum": ["PENDING", "EVIDENCE_COMPLETE"] },
        "subjectSha256": { "$ref": "#/$defs/nullableSha256" },
        "journal": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "prefixItems": [
            { "$ref": "#/$defs/journal1" },
            { "$ref": "#/$defs/journal2" },
            { "$ref": "#/$defs/journal3" },
            { "$ref": "#/$defs/journal4" },
            { "$ref": "#/$defs/journal5" },
            { "$ref": "#/$defs/journal6" },
            { "$ref": "#/$defs/journal7" },
            { "$ref": "#/$defs/journal8" },
            { "$ref": "#/$defs/journal9" },
            { "$ref": "#/$defs/journal10" },
            { "$ref": "#/$defs/journal11" },
            { "$ref": "#/$defs/journal12" },
            { "$ref": "#/$defs/journal13" },
            { "$ref": "#/$defs/journal14" },
            { "$ref": "#/$defs/journal15" },
            { "$ref": "#/$defs/journal16" },
            { "$ref": "#/$defs/journal17" }
          ],
          "items": false
        },
        "terminalState": { "$ref": "#/$defs/terminalState" },
        "terminalEndpointReceipts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/receipt" }
        },
        "automatedClosureReceipt": { "$ref": "#/$defs/nullableReceipt" },
        "blocker": { "$ref": "#/$defs/nullableBlocker" }
      }
    },
    "authorizationBoundary": {
      "const": {
        "signingAuthorized": false,
        "deploymentAuthorized": false,
        "fundingSpendAuthorized": false,
        "activationAuthorized": false,
        "automatedGate8EvidenceComplete": false,
        "releaseAuthorized": false,
        "mainnetExecutionAuthorized": false,
        "mainnetStatus": "HOLD"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "base58": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "nullableBase58": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/base58" }
      ]
    },
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "nullableU64": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/u64" }
      ]
    },
    "nullableBlocker": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 24 }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "stage",
        "sourceId",
        "observedAtUnixSeconds",
        "endpointSha256",
        "subjectSha256",
        "observationValue",
        "decision",
        "signatureBase64url"
      ],
      "properties": {
        "schema": { "const": "iat-b3-production-identity-authority-automated-receipt/v3" },
        "kind": {
          "enum": [
            "MAINNET_GENESIS_ENDPOINT_RECEIPT",
            "AUTOMATED_IDENTITY_CLOSURE_RECEIPT",
            "PAYER_BALANCE_ENDPOINT_RECEIPT",
            "AUTOMATED_FUNDING_CLOSURE_RECEIPT",
            "TERMINAL_AUTHORITY_STATE_ENDPOINT_RECEIPT",
            "AUTOMATED_DEPLOYED_SEAL_CLOSURE_RECEIPT"
          ]
        },
        "stage": { "enum": ["A", "B", "C"] },
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:/-]{7,127}$"
        },
        "observedAtUnixSeconds": { "$ref": "#/$defs/u64" },
        "endpointSha256": { "$ref": "#/$defs/nullableSha256" },
        "subjectSha256": { "$ref": "#/$defs/sha256" },
        "observationValue": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decision": { "enum": ["ACCEPT", "MATCHED"] },
        "signatureBase64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "nullableReceipt": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/receipt" }
      ]
    },
    "ownerDecisionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "stage",
        "sourceId",
        "observedAtUnixSeconds",
        "endpointSha256",
        "subjectSha256",
        "observationValue",
        "decision",
        "signatureScheme",
        "ocmsVersion",
        "signerDerivationPath",
        "signerSolanaPublicKey",
        "capabilityObservationSha256",
        "ocmsApplicationDomainBase64url",
        "decisionPayloadBase64url",
        "decisionPayloadSha256",
        "ocmsMessageBase64url",
        "ocmsMessageSha256",
        "ocmsEnvelopeBase64url",
        "ocmsEnvelopeSha256",
        "signatureBase64url"
      ],
      "properties": {
        "schema": { "const": "iat-b3-production-identity-authority-owner-decision-ocms-receipt/v1" },
        "kind": { "enum": ["OWNER_IDENTITY_DECISION_RECEIPT", "OWNER_FUNDING_DECISION_RECEIPT"] },
        "stage": { "enum": ["A", "B"] },
        "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{7,127}$" },
        "observedAtUnixSeconds": { "$ref": "#/$defs/u64" },
        "endpointSha256": { "type": "null" },
        "subjectSha256": { "$ref": "#/$defs/sha256" },
        "observationValue": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decision": { "const": "ACCEPT" },
        "signatureScheme": { "const": "TREZOR_MODEL_T_SOLANA_OCMS" },
        "ocmsVersion": { "enum": ["OCMS_V0", "OCMS_V1"] },
        "signerDerivationPath": { "type": "string", "pattern": "^m/44'/501'/(0|[1-9][0-9]*)'/(0|[1-9][0-9]*)'$" },
        "signerSolanaPublicKey": { "$ref": "#/$defs/base58" },
        "capabilityObservationSha256": { "$ref": "#/$defs/sha256" },
        "ocmsApplicationDomainBase64url": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          ]
        },
        "decisionPayloadBase64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "decisionPayloadSha256": { "$ref": "#/$defs/sha256" },
        "ocmsMessageBase64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "ocmsMessageSha256": { "$ref": "#/$defs/sha256" },
        "ocmsEnvelopeBase64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "ocmsEnvelopeSha256": { "$ref": "#/$defs/sha256" },
        "signatureBase64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "nullableOwnerDecisionReceipt": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/ownerDecisionReceipt" }
      ]
    },
    "modelTCapabilityObservationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sourceId",
        "observedAtUnixSeconds",
        "ownerDecisionSourceId",
        "deviceModel",
        "firmwareVersion",
        "capabilityPredicate",
        "ocmsVersion",
        "derivationPath",
        "solanaPublicKey",
        "observationClass",
        "observationValue",
        "signatureBase64url"
      ],
      "properties": {
        "schema": { "const": "iat-b3-production-identity-authority-model-t-capability-observation/v1" },
        "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{7,127}$" },
        "observedAtUnixSeconds": { "$ref": "#/$defs/u64" },
        "ownerDecisionSourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{7,127}$" },
        "deviceModel": { "const": "Trezor Model T" },
        "firmwareVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "capabilityPredicate": { "const": "MODEL_T_SOLANA_OCMS_CAPABILITY_OBSERVED" },
        "ocmsVersion": { "enum": ["OCMS_V0", "OCMS_V1"] },
        "derivationPath": { "type": "string", "pattern": "^m/44'/501'/(0|[1-9][0-9]*)'/(0|[1-9][0-9]*)'$" },
        "solanaPublicKey": { "$ref": "#/$defs/base58" },
        "observationClass": { "enum": ["PRODUCTION_SOURCE_BOUND_DEVICE_OBSERVATION", "SYNTHETIC_SOFTWARE_TEST_FIXTURE"] },
        "observationValue": { "const": "CAPABILITY_PRESENT" },
        "signatureBase64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "binaryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programId", "sha256", "byteLength", "sourceHeadSha256"],
      "properties": {
        "programId": { "$ref": "#/$defs/nullableBase58" },
        "sha256": { "$ref": "#/$defs/nullableSha256" },
        "byteLength": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 10000000 }
          ]
        },
        "sourceHeadSha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "journalEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "step", "status", "evidenceSha256"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 17 },
        "step": { "type": "string" },
        "status": { "enum": ["PENDING", "FINALIZED_MATCHED"] },
        "evidenceSha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "journal1": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 1 }, "step": { "const": "DEPLOY_LAW_WITH_HARDWARE_UPGRADE_AUTHORITY" } } }] },
    "journal2": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 2 }, "step": { "const": "DEPLOY_ECONOMY_WITH_HARDWARE_UPGRADE_AUTHORITY" } } }] },
    "journal3": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 3 }, "step": { "const": "VERIFY_EXACT_PROGRAM_BYTES_AND_IDENTITIES" } } }] },
    "journal4": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 4 }, "step": { "const": "REVOKE_LAW_UPGRADE_AUTHORITY" } } }] },
    "journal5": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 5 }, "step": { "const": "REVOKE_ECONOMY_UPGRADE_AUTHORITY" } } }] },
    "journal6": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 6 }, "step": { "const": "VERIFY_BOTH_PROGRAMS_IMMUTABLE" } } }] },
    "journal7": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 7 }, "step": { "const": "CREATE_EXACT_TOKEN_2022_MINT" } } }] },
    "journal8": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 8 }, "step": { "const": "ENTER_GENESIS_STAGING" } } }] },
    "journal9": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 9 }, "step": { "const": "CREATE_AND_FUND_CANONICAL_ACCOUNTS" } } }] },
    "journal10": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 10 }, "step": { "const": "VERIFY_GENESIS_CONSERVATION_AND_BINDINGS" } } }] },
    "journal11": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 11 }, "step": { "const": "REVOKE_MINT_AUTHORITY" } } }] },
    "journal12": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 12 }, "step": { "const": "REVOKE_FREEZE_AUTHORITY" } } }] },
    "journal13": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 13 }, "step": { "const": "INITIALIZE_LAW_AND_SEAL_EXTENSION_AUTHORITIES" } } }] },
    "journal14": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 14 }, "step": { "const": "VERIFY_MINT_AND_PROGRAM_AUTHORITIES_SEALED" } } }] },
    "journal15": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 15 }, "step": { "const": "FINALIZE_CURRENT_DAY" } } }] },
    "journal16": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 16 }, "step": { "const": "ACTIVATE_ONLY_IF_CURRENT_DAY_OPEN" } } }] },
    "journal17": { "allOf": [{ "$ref": "#/$defs/journalEntry" }, { "properties": { "ordinal": { "const": 17 }, "step": { "const": "VERIFY_ACTIVE_AND_STAGING_DISABLED" } } }] },
    "terminalState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lawProgramId",
        "economyProgramId",
        "canonicalMint",
        "lawBinarySha256",
        "economyBinarySha256",
        "lawUpgradeAuthority",
        "economyUpgradeAuthority",
        "mintAuthority",
        "freezeAuthority",
        "transferHookAuthority",
        "confidentialTransferMintAuthority",
        "active",
        "genesisStagingWritesDisabled",
        "stateSha256"
      ],
      "properties": {
        "lawProgramId": { "$ref": "#/$defs/nullableBase58" },
        "economyProgramId": { "$ref": "#/$defs/nullableBase58" },
        "canonicalMint": { "$ref": "#/$defs/nullableBase58" },
        "lawBinarySha256": { "$ref": "#/$defs/nullableSha256" },
        "economyBinarySha256": { "$ref": "#/$defs/nullableSha256" },
        "lawUpgradeAuthority": { "$ref": "#/$defs/nullableBase58" },
        "economyUpgradeAuthority": { "$ref": "#/$defs/nullableBase58" },
        "mintAuthority": { "$ref": "#/$defs/nullableBase58" },
        "freezeAuthority": { "$ref": "#/$defs/nullableBase58" },
        "transferHookAuthority": { "$ref": "#/$defs/nullableBase58" },
