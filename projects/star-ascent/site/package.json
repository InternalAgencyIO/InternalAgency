{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate:mint-config": "node scripts/generate-mint-ceremony-config.mjs",
    "predev": "npm run generate:mint-config && npm run compile:i18n",
    "dev": "vinext dev",
    "prebuild": "npm run generate:mint-config && npm run compile:i18n",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run check:qa:i18n && npm run check:favicon && npm run build && node --import ./tests/register-cloudflare-workers-loader.mjs --test tests/rendered-html.test.mjs tests/i18n-routing.test.mjs",
    "check:favicon": "node --test tests/favicon.test.mjs",
    "check:future-teasers": "node --test tests/future-teasers.test.mjs",
    "extract:i18n": "node scripts/generate-i18n-catalog.mjs --extract-only",
    "generate:i18n:local": "python scripts/generate-i18n-local.py && npm run compile:i18n",
    "generate:i18n": "npm run extract:i18n && npm run generate:i18n:local",
    "compile:i18n": "node scripts/prune-i18n-catalog.mjs && node scripts/compile-i18n-assets.mjs",
    "check:i18n": "npm run compile:i18n && node scripts/check-i18n-catalog.mjs",
    "check:qa:i18n": "npm run check:i18n && node scripts/generate-localization-qa-report.mjs && node --test tests/i18n-html-extraction.test.mjs tests/i18n-quality.test.mjs",
    "check:seo:i18n": "npm run build && node --import ./tests/register-cloudflare-workers-loader.mjs --test tests/i18n-routing.test.mjs",
    "check:public": "node scripts/check-public-launch-routes.mjs",
    "check:manifest-gate": "node scripts/test-manifest-gate-regression.mjs",
    "check:publication-payload": "node scripts/test-publication-payload-regression.mjs",
    "check:release-evidence-chain": "node scripts/test-release-evidence-chain-regression.mjs",
    "check:devnet-rehearsal": "node scripts/test-devnet-rehearsal-regression.mjs",
    "check:token-metadata": "node scripts/validate-token-metadata.mjs",
    "check:allocation-lock-plan": "node scripts/validate-allocation-lock-plan.mjs",
    "check:mint-config": "node scripts/test-mint-config-regression.mjs",
    "check:signer-checklist": "node scripts/test-signing-checklist-regression.mjs",
    "check:mainnet-handoff": "node scripts/test-mainnet-handoff-regression.mjs",
    "check:release-packet": "node scripts/test-release-packet-regression.mjs",
    "check:pre-publication-packet": "node scripts/test-pre-publication-packet-proof-regression.mjs",
    "check:release-snapshot": "node scripts/test-release-snapshot-regression.mjs",
    "check:post-genesis-reconciliation": "node scripts/test-post-genesis-reconciliation-regression.mjs",
    "check:incoming-artwork": "node scripts/test-incoming-artwork-manifest-regression.mjs",
    "check:operator-cards": "node scripts/check-genesis-operator-cards.mjs",
    "check:launch-clock": "node scripts/verify-launch-schedule.mjs && node scripts/test-launch-clock-evidence-state.mjs",
    "check:mint-ceremony": "node --test tests/mint-ceremony.test.mjs",
    "check:launch-social": "node scripts/check-launch-social-links.mjs",
    "check:dossier-encoding": "node scripts/test-dossier-reader-encoding.mjs",
    "check:dossier-navigation": "node scripts/test-dossier-reader-navigation.mjs",
    "check:label-normalization": "node scripts/test-accountability-label-normalization.mjs",
    "check:canonical-digest": "node scripts/test-canonical-digest-regression.mjs",
    "check:launch-gates": "npm run check:label-normalization && npm run check:canonical-digest && npm run check:manifest-gate && npm run check:publication-payload && npm run check:release-evidence-chain && npm run check:token-metadata && npm run check:allocation-lock-plan && npm run check:devnet-rehearsal && npm run check:signer-checklist && npm run check:mainnet-handoff && npm run check:release-packet && npm run check:pre-publication-packet && npm run check:release-snapshot && npm run check:post-genesis-reconciliation && npm run check:incoming-artwork && npm run check:operator-cards && npm run check:launch-clock && npm run check:mint-config && npm run check:mint-ceremony",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern outputs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "3.4.0",
    "@metaplex-foundation/umi": "1.0.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "buffer": "6.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
