{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate:mint-config": "node scripts/generate-mint-ceremony-config.mjs",
    "bind:iat-v2-program-id": "node scripts/bind-iat-v2-program-id.mjs",
    "iat:v2-admin": "vite --config tools/iat-v2-admin-console/vite.config.mjs",
    "iat:v2-feature-preflight": "node scripts/iat-v2-feature-preflight.mjs",
    "build:iat-v2-admin": "vite build --config tools/iat-v2-admin-console/vite.config.mjs",
    "predev": "npm run generate:mint-config",
    "dev": "vinext dev",
    "prebuild": "npm run generate:mint-config",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --import ./tests/register-cloudflare-workers-loader.mjs --test tests/rendered-html.test.mjs",
    "check:public": "node scripts/check-public-launch-routes.mjs",
    "check:ui-regression": "playwright test",
    "check:manifest-gate": "node scripts/test-manifest-gate-regression.mjs",
    "check:publication-payload": "node scripts/test-publication-payload-regression.mjs",
    "check:release-evidence-chain": "node scripts/test-release-evidence-chain-regression.mjs",
    "check:devnet-rehearsal": "node scripts/test-devnet-rehearsal-regression.mjs",
    "check:token-metadata": "node scripts/validate-token-metadata.mjs",
    "check:tokenomics": "node scripts/verify-tokenomics-v2.mjs",
    "check:iat-v2": "node scripts/validate-ui-compatibility-audit.mjs && node scripts/validate-future-dlc-audits.mjs && node scripts/validate-iat-v2-prelaunch-audit.mjs && node scripts/validate-iat-v2-remediation-audit.mjs && node scripts/validate-iat-v2-policy.mjs && node scripts/validate-binding-ledger-schema.mjs && node scripts/validate-daily-rewards-policy.mjs && node scripts/validate-public-devnet-evidence.mjs && node scripts/validate-iat-v2-time-gate-proof.mjs && node scripts/test-iat-v2-mainnet-funding-observation-regression.mjs && node scripts/validate-iat-v2-mainnet-readiness-gate.mjs && node scripts/test-iat-v2-mainnet-ceremony-entry-regression.mjs && node scripts/test-iat-v2-canonical-json-regression.mjs && node scripts/validate-iat-v2-mainnet-stage-journal.mjs && node scripts/test-iat-v2-mainnet-stage-journal-regression.mjs && node --test tests/node-binding-security.test.mjs tests/x-oauth-d1-local-rehearsal.test.mjs tests/daily-budget-security.test.mjs tests/iat-v2-genesis-feature-gates.test.mjs tests/iat-v2-reference-engine.test.mjs tests/iat-v2-client.test.mjs tests/iat-v2-instructions.test.mjs tests/iat-v2-feature-instructions.test.mjs tests/iat-v2-feature-rehearsal.test.mjs tests/iat-v2-program-binding.test.mjs tests/iat-v2-trezor-provider.test.mjs tests/iat-network.test.mjs",
    "check:future-dlc-audits": "node scripts/validate-future-dlc-audits.mjs",
    "check:prelaunch-audit": "node scripts/validate-iat-v2-prelaunch-audit.mjs",
    "check:remediation-audit": "node scripts/validate-iat-v2-remediation-audit.mjs",
    "check:ui-audit": "node scripts/validate-ui-compatibility-audit.mjs",
    "check:iat-v2-time-gates": "node scripts/validate-iat-v2-time-gate-proof.mjs && node --test tests/iat-v2-reference-engine.test.mjs",
    "check:iat-v2-mainnet-readiness": "node scripts/test-iat-v2-mainnet-funding-observation-regression.mjs && node scripts/validate-iat-v2-mainnet-readiness-gate.mjs",
    "refresh:iat-v2-mainnet-funding": "node scripts/refresh-iat-v2-mainnet-funding-observation.mjs",
    "check:iat-v2-ceremony-entry": "node scripts/validate-iat-v2-mainnet-readiness-gate.mjs && node scripts/test-iat-v2-mainnet-ceremony-entry-regression.mjs",
    "check:iat-v2-stage-journal": "node scripts/validate-iat-v2-mainnet-stage-journal.mjs && node scripts/test-iat-v2-mainnet-stage-journal-regression.mjs",
    "check:iat-v2-canonical-json": "node scripts/test-iat-v2-canonical-json-regression.mjs",
    "check:public-evidence": "node scripts/validate-public-devnet-evidence.mjs",
    "check:iat-v2-signoff": "node scripts/validate-iat-v2-independent-signoff.mjs && node scripts/validate-iat-v2-feature-signoff.mjs",
    "check:allocation-lock-plan": "node scripts/validate-allocation-lock-plan.mjs",
    "check:mint-config": "node scripts/test-mint-config-regression.mjs",
    "check:signer-checklist": "node scripts/test-signing-checklist-regression.mjs",
    "check:mainnet-handoff": "node scripts/test-mainnet-handoff-regression.mjs",
    "check:release-packet": "node scripts/test-release-packet-regression.mjs",
    "check:pre-publication-packet": "node scripts/test-pre-publication-packet-proof-regression.mjs",
    "check:release-snapshot": "node scripts/test-release-snapshot-regression.mjs",
    "check:post-genesis-reconciliation": "node scripts/test-post-genesis-reconciliation-regression.mjs",
    "check:incoming-artwork": "node scripts/test-incoming-artwork-manifest-regression.mjs",
    "check:operator-cards": "node scripts/check-genesis-operator-cards.mjs",
    "check:launch-clock": "node scripts/verify-launch-schedule.mjs && node scripts/test-launch-clock-evidence-state.mjs",
    "check:mint-ceremony": "node --test tests/mint-ceremony.test.mjs",
    "check:launch-social": "node scripts/check-launch-social-links.mjs",
    "check:dossier-encoding": "node scripts/test-dossier-reader-encoding.mjs",
    "check:dossier-navigation": "node scripts/test-dossier-reader-navigation.mjs",
    "check:label-normalization": "node scripts/test-accountability-label-normalization.mjs",
    "check:canonical-digest": "node scripts/test-canonical-digest-regression.mjs",
    "check:launch-gates": "npm run check:tokenomics && npm run check:iat-v2-mainnet-readiness && npm run check:iat-v2-ceremony-entry && npm run check:iat-v2-canonical-json && npm run check:iat-v2-stage-journal && npm run check:label-normalization && npm run check:canonical-digest && npm run check:manifest-gate && npm run check:publication-payload && npm run check:release-evidence-chain && npm run check:token-metadata && npm run check:allocation-lock-plan && npm run check:devnet-rehearsal && npm run check:signer-checklist && npm run check:mainnet-handoff && npm run check:release-packet && npm run check:pre-publication-packet && npm run check:release-snapshot && npm run check:post-genesis-reconciliation && npm run check:incoming-artwork && npm run check:operator-cards && npm run check:launch-clock && npm run check:mint-config && npm run check:mint-ceremony",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern \"**/dist/**\" --ignore-pattern .next --ignore-pattern work",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@cloudflare/workers-types": "5.20260729.1",
    "@coral-xyz/anchor": "0.31.1",
    "@metaplex-foundation/mpl-token-metadata": "3.4.0",
    "@metaplex-foundation/umi": "1.0.0",
    "@playwright/test": "1.62.1",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "@switchboard-xyz/on-demand": "3.10.6",
    "@tailwindcss/postcss": "4.2.1",
    "@trezor/connect-web": "10.0.0-beta.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "axe-core": "4.12.1",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.115.0"
  },
  "type": "module"
}
